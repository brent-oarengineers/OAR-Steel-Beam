<Project Sdk="Microsoft.NET.Sdk">

  <!-- The small add-in Excel registers: at every Excel start it fetches the approved OAR Steel add-in from the
       office share (if newer) into its own version folder and loads it. Changes rarely. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Loader.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="OAR.Steel.Loader-AddIn.dna" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.8.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
